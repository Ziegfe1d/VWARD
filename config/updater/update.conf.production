# VWARD Update Engine production bootstrap configuration.
# Signed checks and automatic installation are enabled after live-router
# apply, rollback and updater-owned runtime-barrier acceptance passed.
update_enabled=1
auto_apply=1
auto_critical=1
auto_important=1
auto_routine=1

manifest_url=https://raw.githubusercontent.com/Ziegfe1d/VWARD/main/updates/dev/update-manifest.json
public_key_file=/opt/etc/vward/update-public.pem
channel=dev

safe_window_start=03:00
safe_window_end=05:00
important_max_delay_seconds=7200
routine_max_delay_seconds=86400

minimum_free_kb=8192
max_manifest_size=262144
max_package_size=16777216
max_unpacked_size=67108864
backup_keep=3
health_timeout_seconds=30
check_interval_seconds=900
request_timeout_seconds=120
current_version_file=/opt/share/vward/VERSION

barrier_integration_ready=1
