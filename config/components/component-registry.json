{
  "schema": 1,
  "platform": "VWARD Platform",
  "platform_version": "0.2.0-beta.1",
  "component_version_policy": "platform-release",
  "components": [
    {
      "id": "platform-core",
      "name": "VWARD Platform Core",
      "name_ru": "Ядро платформы VWARD",
      "legacy_ids": [
        "bootstrap"
      ],
      "update_method": "signed-package",
      "health_profile": "default",
      "runtime_targets": [
        "/opt/share/vward/VERSION"
      ]
    },
    {
      "id": "route-engine",
      "name": "VWARD Route Engine",
      "name_ru": "Движок адаптивной маршрутизации VWARD",
      "legacy_ids": [
        "adaptive-routing"
      ],
      "update_method": "signed-package",
      "health_profile": "route-engine",
      "runtime_targets": [
        "/opt/bin/agh-adaptive-live.sh"
      ]
    },
    {
      "id": "route-reconciler",
      "name": "VWARD Route Reconciler",
      "name_ru": "Сверка адаптивных маршрутов VWARD",
      "legacy_ids": [],
      "update_method": "signed-package",
      "health_profile": "route-engine",
      "depends_on": [
        "route-engine"
      ],
      "runtime_targets": [
        "/opt/bin/adaptive-auto-maint.sh"
      ]
    },
    {
      "id": "route-tools",
      "name": "VWARD Route Tools",
      "name_ru": "Инструменты маршрутизации VWARD",
      "legacy_ids": [],
      "update_method": "signed-package",
      "health_profile": "route-tools",
      "runtime_targets": [
        "/opt/bin/adaptive-2ip-test.sh",
        "/opt/bin/adaptive-hints-update.sh",
        "/opt/bin/adaptive-resolve4.sh",
        "/opt/bin/adaptive-route.sh",
        "/opt/bin/agh-adaptive-route.sh"
      ]
    },
    {
      "id": "tunnel-guard",
      "name": "VWARD Tunnel Guard",
      "name_ru": "Защита VPN-туннеля VWARD",
      "legacy_ids": [
        "wireguard-protection"
      ],
      "update_method": "signed-package",
      "health_profile": "tunnel-guard",
      "runtime_targets": [
        "/opt/bin/wg-health-watch.sh",
        "/opt/bin/wg-failopen-guard.sh"
      ]
    },
    {
      "id": "wan-guard",
      "name": "VWARD WAN Guard",
      "name_ru": "Защита WAN VWARD",
      "legacy_ids": [
        "wan-guardian"
      ],
      "update_method": "signed-package",
      "health_profile": "wan-guard",
      "runtime_targets": [
        "/opt/bin/wan-health-watch.sh",
        "/opt/bin/wan-recovery-plan.sh",
        "/opt/bin/wan-guardian.sh",
        "/opt/bin/wan-recovery-actuator.sh"
      ]
    },
    {
      "id": "policy-sync",
      "name": "VWARD Policy Sync",
      "name_ru": "Синхронизация сетевых политик VWARD",
      "legacy_ids": [
        "vpn-audit"
      ],
      "update_method": "signed-package",
      "health_profile": "policy-sync",
      "runtime_targets": [
        "/opt/bin/vpn-domain-audit-chain.sh",
        "/opt/bin/vpn-domain-audit.sh",
        "/opt/bin/vpn-night-reconcile.sh",
        "/opt/bin/vpn-subnet-sync.sh"
      ]
    },
    {
      "id": "runtime",
      "name": "VWARD Runtime",
      "name_ru": "Среда выполнения VWARD",
      "legacy_ids": [
        "runtime-supervision"
      ],
      "update_method": "signed-package",
      "health_profile": "runtime",
      "runtime_targets": [
        "/opt/bin/vward-discovery.sh",
        "/opt/bin/adaptive-housekeeping.sh",
        "/opt/bin/crond-supervisor.sh",
        "/opt/etc/init.d/S90crond",
        "/opt/etc/init.d/S91adaptive-live",
        "/opt/etc/init.d/S92crond-supervisor",
        "/opt/etc/init.d/S93keenetic-apps"
      ]
    },
    {
      "id": "console",
      "name": "VWARD Console",
      "name_ru": "Панель управления VWARD",
      "legacy_ids": [
        "web-ui"
      ],
      "update_method": "signed-package",
      "health_profile": "console",
      "runtime_targets": [
        "/opt/etc/keenetic-apps/lighttpd.conf",
        "/opt/share/keenetic-apps/www/index.html",
        "/opt/share/keenetic-apps/www/cgi-bin/api.cgi"
      ]
    },
    {
      "id": "update-engine",
      "name": "VWARD Update Engine",
      "name_ru": "Движок обновлений VWARD",
      "legacy_ids": [
        "updater"
      ],
      "update_method": "slot-installer",
      "health_profile": "updater",
      "depends_on": [
        "platform-core"
      ],
      "runtime_targets": [
        "/opt/share/vward/updater/current"
      ]
    }
  ]
}
