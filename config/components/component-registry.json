{
  "schema": 1,
  "platform": "VWARD Platform",
  "platform_version": "0.2.0-dev.2",
  "component_version_policy": "platform-release",
  "components": [
    {
      "id": "platform-core",
      "name": "VWARD Platform Core",
      "name_ru": "Ядро платформы VWARD",
      "legacy_ids": [],
      "update_method": "signed-package",
      "health_profile": "default",
      "runtime_targets": ["/opt/share/vward/VERSION"]
    },
    {
      "id": "route-engine",
      "name": "VWARD Route Engine",
      "name_ru": "Движок адаптивной маршрутизации VWARD",
      "legacy_ids": [],
      "update_method": "signed-package",
      "health_profile": "route-engine",
      "runtime_targets": ["/opt/bin/vward-route-engine.sh"]
    },
    {
      "id": "route-reconciler",
      "name": "VWARD Route Reconciler",
      "name_ru": "Сверка адаптивных маршрутов VWARD",
      "legacy_ids": [],
      "update_method": "signed-package",
      "health_profile": "route-engine",
      "depends_on": ["route-engine"],
      "runtime_targets": ["/opt/bin/vward-route-reconciler.sh"]
    },
    {
      "id": "route-tools",
      "name": "VWARD Route Tools",
      "name_ru": "Инструменты маршрутизации VWARD",
      "legacy_ids": [],
      "update_method": "signed-package",
      "health_profile": "route-tools",
      "runtime_targets": [
        "/opt/bin/vward-route-test.sh",
        "/opt/bin/vward-route-hints-update.sh",
        "/opt/bin/vward-route-resolve4.sh",
        "/opt/bin/vward-route.sh",
        "/opt/bin/vward-route-discovery.sh"
      ]
    },
    {
      "id": "tunnel-guard",
      "name": "VWARD Tunnel Guard",
      "name_ru": "Защита VPN-туннеля VWARD",
      "legacy_ids": [],
      "update_method": "signed-package",
      "health_profile": "tunnel-guard",
      "runtime_targets": [
        "/opt/bin/vward-tunnel-health.sh",
        "/opt/bin/vward-tunnel-guard.sh"
      ]
    },
    {
      "id": "wan-guard",
      "name": "VWARD WAN Guard",
      "name_ru": "Защита WAN VWARD",
      "legacy_ids": [],
      "update_method": "signed-package",
      "health_profile": "wan-guard",
      "runtime_targets": [
        "/opt/bin/vward-wan-guard.sh",
        "/opt/bin/vward-wan-recovery.sh"
      ]
    },
    {
      "id": "policy-sync",
      "name": "VWARD Policy Sync",
      "name_ru": "Синхронизация сетевых политик VWARD",
      "legacy_ids": [],
      "update_method": "signed-package",
      "health_profile": "policy-sync",
      "runtime_targets": [
        "/opt/bin/vward-policy-chain.sh",
        "/opt/bin/vward-policy-audit.sh",
        "/opt/bin/vward-policy-reconcile.sh",
        "/opt/bin/vward-policy-sync.sh"
      ]
    },
    {
      "id": "runtime",
      "name": "VWARD Runtime",
      "name_ru": "Среда выполнения VWARD",
      "legacy_ids": [],
      "update_method": "signed-package",
      "health_profile": "runtime",
      "runtime_targets": [
        "/opt/bin/vward-housekeeping.sh",
        "/opt/bin/vward-cron-supervisor.sh",
        "/opt/etc/init.d/S90crond",
        "/opt/etc/init.d/S91vward-route-engine",
        "/opt/etc/init.d/S92vward-runtime",
        "/opt/etc/init.d/S93vward-console"
      ]
    },
    {
      "id": "console",
      "name": "VWARD Console",
      "name_ru": "Панель управления VWARD",
      "legacy_ids": [],
      "update_method": "signed-package",
      "health_profile": "console",
      "runtime_targets": [
        "/opt/etc/vward/console/lighttpd.conf",
        "/opt/share/vward/console/www/index.html",
        "/opt/share/vward/console/www/cgi-bin/api.cgi"
      ]
    },
    {
      "id": "update-engine",
      "name": "VWARD Update Engine",
      "name_ru": "Движок обновлений VWARD",
      "legacy_ids": [],
      "update_method": "slot-installer",
      "health_profile": "updater",
      "depends_on": ["platform-core"],
      "runtime_targets": ["/opt/share/vward/updater/current"]
    }
  ]
}
