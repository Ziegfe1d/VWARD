{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VWARD Settings Registry",
  "type": "object",
  "required": [
    "schema",
    "settings"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "component",
          "section",
          "label_ru",
          "description_ru",
          "source",
          "key",
          "type",
          "editable",
          "secret",
          "restart_requirement",
          "risk"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "component": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "label_ru": {
            "type": "string"
          },
          "description_ru": {
            "type": "string"
          },
          "source": {
            "enum": [
              "ads-privacy-guard.conf",
              "browser",
              "device.conf",
              "update.conf"
            ]
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "type": {
            "enum": [
              "boolean",
              "integer",
              "ipv4",
              "cidr4",
              "interface",
              "string",
              "url"
            ]
          },
          "editable": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          },
          "restart_requirement": {
            "enum": [
              "none",
              "component",
              "console-deferred"
            ]
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "allowed_values": {
            "type": "array"
          },
          "minimum": {
            "type": "integer"
          },
          "maximum": {
            "type": "integer"
          },
          "read_only_reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "parts_schema": {
      "const": 1
    },
    "parts_groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parts_agents": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "group",
          "desc",
          "switch",
          "agent"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "component",
              "module",
              "service",
              "extra"
            ]
          },
          "title": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "switch": {
            "enum": [
              null,
              "component",
              "module",
              "extra"
            ]
          },
          "agent": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
