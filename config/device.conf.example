# Copy to /opt/etc/vward/device.conf only when discovery is ambiguous.
# Empty values are discovered at runtime and must resolve to exactly one candidate.
VWARD_LAN_ADDRESS=
VWARD_LAN_SUBNET=
VWARD_LAN_INTERFACE=
VWARD_DNS_SERVER=
VWARD_PROBE_DNS=
VWARD_ADGUARD_ADDRESS=
VWARD_ADGUARD_PORT=3000
VWARD_WAN_DEVICE=
VWARD_WAN_INTERFACE=
VWARD_TUNNEL_DEVICE=
VWARD_TUNNEL_INTERFACE=
VWARD_POLICY_GROUP=
VWARD_CONSOLE_PORT=8088
VWARD_RCI_BASE=http://127.0.0.1:79/rci
# Every request to Keenetic (RCI, ndmc) timed and counted by the hour, 1 s and more into
# keenetic-slow.log (fix.33.2); 0 keeps only the old journal of 3 s and more.
# VWARD_KEENETIC_TIMING=1
# VWARD_KEENETIC_SLOW=1
# Keenetic's RCI silent: wan-guard checks the carrier and an outside address before saying
# «UTILITY_DEGRADED» (fix.33.2); 0 says it at once, as before.
# VWARD_WAN_RCI_PROBES=1
# Heavy cron jobs start later than the minute's agents (route upkeep 35 s, Wi-Fi 15 s) and wait
# while Keenetic answered in 2 s or more within 90 s (fix.33.2); 0 turns each off.
# VWARD_SPREAD=1
# VWARD_KEENETIC_BUSY=1
# The route engine's start: AdaptiveAuto restored from USB within this many seconds of Keenetic
# calls, so S91's 12 s start wait holds (fix.34); the names left are counted in the journal.
# VWARD_RESTORE_SECONDS=8
# The Panel's look at Keenetic's whole configuration: the shared copy up to this many seconds
# old (fix.34; was 10). VWARD's own changes drop it at once; 10 brings back the old behaviour.
# VWARD_CONSOLE_CONFIG_TTL=60
# IP categories' night check: every 20 sites it waits while Keenetic is busy (15 s at a time,
# 600 s at most) and counts why sites did not pass (fix.34); 0 runs it straight through.
# VWARD_AUDIT_PAUSE=1

# Retry rejected route-domain DNS bindings after 60 s; 0 retains the old hold until restart.
# VWARD_AGH_BIND_RETRY=60

# Show the router IPv4 route separately from FQDN settings; 0 skips local route lookups.
# VWARD_ROUTE_PROBE_KERNEL=1
