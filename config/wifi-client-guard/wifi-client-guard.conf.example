# VWARD Wi-Fi Client Guard local configuration
# This file is intentionally NOT auto-created by a signed package.

ENABLED=0
CONTROL_ENABLED=0
AUTO_APPLY=0

# Empty: the home segment is discovered as the Keenetic interface that owns the
# LAN address from the device profile. Set only when discovery is ambiguous.
HOME_BRIDGE=

# Empty: each access point's band is read from its radio (band or channel) via
# Keenetic RCI. Optional regex overrides; unmatched APs remain UNKNOWN.
AP_2G_PATTERN=
AP_5G_PATTERN=

SAMPLE_RETENTION_SEC=172800
WINDOW_SEC=86400
BAND_SWITCH_WARN=20
WEAK_5G_SAMPLE_WARN=5
WEAK_5G_RSSI=-75
