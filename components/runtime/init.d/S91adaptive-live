#!/bin/sh

PATH=/opt/bin:/opt/sbin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

PIDFILE="/opt/var/run/agh-adaptive-live.pid"
SCRIPT="/opt/bin/agh-adaptive-live.sh"
LOG="/opt/var/log/agh-adaptive-live.log"

LIVE_LOCK="/tmp/agh-adaptive-live.lock"
CONTROL_LOCK="/tmp/S91adaptive-live.control.lock"
CHILD_STATE="/tmp/S91adaptive-live.tcpdump-missing"
START_WAIT=12
STOP_WAIT=6
CONTROL_WAIT=20


control_lock()
{
    N=0

    while ! mkdir "$CONTROL_LOCK" 2>/dev/null; do

        OLD=$(cat "$CONTROL_LOCK/pid" 2>/dev/null)

        if [ -n "$OLD" ] &&
           ! kill -0 "$OLD" 2>/dev/null; then

            rm -rf "$CONTROL_LOCK"
            continue
        fi

        sleep 1
        N=$((N + 1))

        [ "$N" -ge "$CONTROL_WAIT" ] && return 1
    done

    echo $$ > "$CONTROL_LOCK/pid"
    return 0
}


control_unlock()
{
    rm -rf "$CONTROL_LOCK"
}


adaptive_live_pids()
{
    ps w |
    awk '
        $6=="/opt/bin/agh-adaptive-live.sh" {
            print $1
        }
    '
}


adaptive_tcpdump_pids()
{
    ps w |
    awk '
        $5=="tcpdump" &&
        index($0,"src net 192.168.1.0/24") &&
        index($0,"dst host 192.168.1.1") {
            print $1
        }
    '
}


kill_all_live()
{
    for P in $(adaptive_live_pids); do
        kill "$P" 2>/dev/null
    done

    N=0

    while [ "$N" -lt "$STOP_WAIT" ]; do

        CNT=$(adaptive_live_pids | wc -l)

        [ "$CNT" -eq 0 ] && return 0

        sleep 1
        N=$((N + 1))
    done

    for P in $(adaptive_live_pids); do
        kill -9 "$P" 2>/dev/null
    done

    sleep 1
}


kill_adaptive_tcpdump()
{
    for P in $(adaptive_tcpdump_pids); do
        kill "$P" 2>/dev/null
    done

    sleep 1

    for P in $(adaptive_tcpdump_pids); do
        kill -9 "$P" 2>/dev/null
    done
}



clean_service()
{
    kill_all_live
    kill_adaptive_tcpdump

    rm -f "$PIDFILE"
    rm -f "$CHILD_STATE"
    rm -rf "$LIVE_LOCK"
}


# Core health belongs to the main Live process.
# tcpdump is a self-healing child owned by agh-adaptive-live.sh.
service_healthy()
{
    PID=$(cat "$PIDFILE" 2>/dev/null)
    LOCKPID=$(cat "$LIVE_LOCK/pid" 2>/dev/null)

    [ -n "$PID" ] || return 1
    [ "$PID" = "$LOCKPID" ] || return 1

    kill -0 "$PID" 2>/dev/null || return 1

    LCNT=$(adaptive_live_pids | wc -l)

    [ "$LCNT" -eq 1 ] || return 1

    return 0
}


start_service()
{
    if service_healthy; then

        PID=$(cat "$PIDFILE")
        TCNT=$(adaptive_tcpdump_pids | wc -l)

        if [ "$TCNT" -eq 1 ]; then
            rm -f "$CHILD_STATE"
            echo "Adaptive Live already running PID=$PID tcpdump=1"
            return 0
        fi

        # tcpdump can legitimately disappear briefly while Live
        # performs its own 2-second self-healing cycle.
        sleep 3

        if ! service_healthy; then
            echo "Adaptive Live core became unhealthy during child grace"
        else
            TCNT=$(adaptive_tcpdump_pids | wc -l)

            if [ "$TCNT" -eq 1 ]; then
                rm -f "$CHILD_STATE"
                echo "Adaptive Live child recovered PID=$PID tcpdump=1"
                return 0
            fi

            MISS=$(cat "$CHILD_STATE" 2>/dev/null)

            case "$MISS" in
                ''|*[!0-9]*) MISS=0 ;;
            esac

            MISS=$((MISS + 1))
            echo "$MISS" > "$CHILD_STATE"

            if [ "$MISS" -lt 3 ]; then
                echo "Adaptive Live core healthy PID=$PID tcpdump=$TCNT child_grace=$MISS/3"
                return 0
            fi

            echo "Adaptive Live tcpdump unhealthy for 3 consecutive watchdog checks - restarting"
        fi
    fi

    # Only core failure, duplicate core process, or persistent child
    # failure reaches this point.
    clean_service

    "$SCRIPT" >> "$LOG" 2>&1 &
    PID=$!

    echo "$PID" > "$PIDFILE"

    N=0

    while [ "$N" -lt "$START_WAIT" ]; do

        kill -0 "$PID" 2>/dev/null || break

        LOCKPID=$(cat "$LIVE_LOCK/pid" 2>/dev/null)
        LCNT=$(adaptive_live_pids | wc -l)
        TCNT=$(adaptive_tcpdump_pids | wc -l)

        if [ "$LOCKPID" = "$PID" ] &&
           [ "$LCNT" -eq 1 ] &&
           [ "$TCNT" -eq 1 ]; then

            rm -f "$CHILD_STATE"

            echo "Adaptive Live started PID=$PID tcpdump=1 wait=${N}s"
            return 0
        fi

        sleep 1
        N=$((N + 1))
    done

    echo "Adaptive Live failed startup health check after ${START_WAIT}s"

    clean_service
    return 1
}
stop_service()
{
    clean_service
    echo "Adaptive Live stopped"
}



status_service()
{
    PID=$(cat "$PIDFILE" 2>/dev/null)
    LOCKPID=$(cat "$LIVE_LOCK/pid" 2>/dev/null)

    LCNT=$(adaptive_live_pids | wc -l)
    TCNT=$(adaptive_tcpdump_pids | wc -l)

    if service_healthy; then

        if [ "$TCNT" -eq 1 ]; then
            echo "Adaptive Live RUNNING PID=$PID"
            echo "Adaptive process count=1"
            echo "Adaptive tcpdump count=1"
            return 0
        fi

        MISS=$(cat "$CHILD_STATE" 2>/dev/null)
        [ -n "$MISS" ] || MISS=0

        echo "Adaptive Live RUNNING/DEGRADED PID=$PID"
        echo "Adaptive process count=1"
        echo "Adaptive tcpdump count=$TCNT"
        echo "Adaptive tcpdump missing streak=$MISS/3"
        return 1
    fi

    echo "Adaptive Live UNHEALTHY/STOPPED"
    echo "PIDFILE=${PID:-none}"
    echo "LOCKPID=${LOCKPID:-none}"
    echo "Adaptive process count=$LCNT"
    echo "Adaptive tcpdump count=$TCNT"

    return 1
}
case "$1" in

    status)
        status_service
        ;;

    start|stop|restart)

        if ! control_lock; then
            echo "Adaptive control busy"
            exit 1
        fi

        trap 'control_unlock' EXIT
        trap 'exit 1' INT TERM

        case "$1" in
            start)
                start_service
                ;;
            stop)
                stop_service
                ;;
            restart)
                stop_service
                sleep 1
                start_service
                ;;
        esac
        ;;

    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
