#!/opt/bin/sh

LIGHTTPD="/opt/sbin/lighttpd"
TEMPLATE="/opt/etc/vward/console/lighttpd.conf"
CONF="/opt/var/run/vward/console-lighttpd.conf"
PIDFILE="/opt/var/run/vward-console-lighttpd.pid"
VWARD_PROFILE_LIB=${VWARD_PROFILE_LIB:-/opt/lib/vward/vward-device-profile.sh}

prepare_config()
{
    [ -r "$VWARD_PROFILE_LIB" ] && [ -r "$TEMPLATE" ] || return 1
    . "$VWARD_PROFILE_LIB"
    vward_profile_load || return 1
    mkdir -p /opt/var/run/vward || return 1
    TMP="$CONF.new.$$"
    sed -e "s/@VWARD_CONSOLE_BIND@/$VWARD_LAN_ADDRESS/g" \
        -e "s/@VWARD_CONSOLE_PORT@/$VWARD_CONSOLE_PORT/g" \
        "$TEMPLATE" > "$TMP" || return 1
    chmod 0600 "$TMP" || return 1
    "$LIGHTTPD" -tt -f "$TMP" >/dev/null 2>&1 || { rm -f "$TMP"; return 1; }
    mv "$TMP" "$CONF"
}

case "$1" in

start)

    if [ -r "$PIDFILE" ]; then

        PID="$(cat "$PIDFILE")"

        if kill -0 "$PID" 2>/dev/null; then
            exit 0
        fi

        rm -f "$PIDFILE"
    fi

    prepare_config || exit 1
    "$LIGHTTPD" -f "$CONF"
    ;;

stop)

    if [ -r "$PIDFILE" ]; then

        PID="$(cat "$PIDFILE")"

        kill "$PID" 2>/dev/null

        rm -f "$PIDFILE"
    fi
    ;;

restart)

    "$0" stop
    sleep 1
    "$0" start
    ;;

*)

    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;

esac
