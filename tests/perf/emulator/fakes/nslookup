#!/bin/sh
# Faults of the chaos run: the DNS does not answer.
[ ! -e /emu/fault-dns ] || { echo ";; connection timed out; no servers could be reached"; exit 1; }
# BusyBox-style answer: "Address N:" lines, as vward-route-resolve4.sh parses.
printf 'Server:    192.0.2.1\nAddress 1: 192.0.2.1\n\nName:      %s\nAddress 1: 198.51.100.7\n' "${1:-example.com}"
exit 0
