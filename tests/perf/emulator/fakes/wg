#!/bin/sh
# Faults of the chaos run: a silent tunnel has an old handshake.
[ ! -e /emu/fault-tunnel ] || { case "$*" in *latest-handshakes*) printf 'peerkey=\t%s\n' "$(( $(date +%s) - 900 ))" ;; esac; exit 0; }
case "$*" in *latest-handshakes*) printf 'peerkey=\t%s\n' "$(date +%s)" ;; *transfer*) printf 'peerkey=\t1000\t2000\n' ;; *) : ;; esac
exit 0
